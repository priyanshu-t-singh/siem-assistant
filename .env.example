# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_MODEL to any LiteLLM-supported model string.
# Only set the API key for the provider you're using.

# Default — Google Gemini (recommended)
LLM_MODEL=gemini/gemma-4-26b-a4b-it
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Alternative providers (uncomment one block) ───────────────────────────────

# OpenAI
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# LLM_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI
# LLM_MODEL=azure/gpt-4o
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# Cohere
# LLM_MODEL=cohere/command-r-plus
# COHERE_API_KEY=...

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ES_HOST=http://localhost:9200

# ─── Optional debug ───────────────────────────────────────────────────────────
# LITELLM_DEBUG=1
